# Data Base Environment Variables
POSTGRES_DB=tf_event_db
POSTGRES_USER=user
POSTGRES_PASSWORD=pass

# JWT Environment Variables
# Clave en Base64 que, decodificada, tenga al menos 32 bytes (256 bits).
# Generala con: openssl rand -base64 32
JWT_SECRET_KEY=REEMPLAZAR-CON-CLAVE-BASE64
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# SMTP Environment Variables
SMTP_HOST= smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=api_email@gmail.com
SMTP_PASSWORD=password
SMTP_FROM=from_email@gmail.com

# Mercado Pago Environment Variables
MERCADO_PAGO_ACCESS_TOKEN=TOCKEN-ACCESS-MP
MERCADO_PAGO_WEBHOOK_SECRET=WEBHOOK-SECRET-MP

# MercadoPago OAuth
MERCADO_PAGO_CLIENT_ID= Secret-Client-ID-MP
MERCADO_PAGO_CLIENT_SECRET=Secret-Client-Secret-MP
MERCADO_PAGO_REDIRECT_URI=https://tu-dominio.com/api/v1/mp/callback
MERCADO_PAGO_FRONTEND_RETURN_URL=https://tu-frontend.com/organizer/mercadopago

# Application
# dev (desarrollo local: recrea el esquema y carga data.sql) o prod
SPRING_PROFILES_ACTIVE=dev

# Cookies session 
# En desarrollo sobre http://localhost dejar COOKIE_SECURE=false; en producción, true (HTTPS).
COOKIE_SECURE=false
# Strict si el frontend y la API comparten sitio (mismo dominio o subdominios).
# None solo si están en dominios distintos (requiere COOKIE_SECURE=true).
COOKIE_SAME_SITE=Strict

# CORS
CORS_ALLOWED_ORIGINS=URL-ALLOWED-ORIGINS
